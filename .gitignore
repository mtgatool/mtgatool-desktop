# Test builds of the SQLite card database (feat/sqlite-card-db). Generated by
# mtgatool-metadata `npm run sqlite`; kept out of git so schema iterations do
# not each add ~17MB of binary to history.
src/assets/resources/*.sqlite

# Generated by npm run build:cards-db-worker: the compiled worker plus the
# SQLite wasm engine copied out of node_modules. Rebuilt by build:workers,
# which every build and start path already runs.
public/cards-db-worker/

# Scratch output of scripts/verify-collection-sql.mjs
dist-verify/

# Local SQLite build served by the web dev server
public/*.sqlite
