{
  "build": {
    "beforeBuildCommand": "npm run build:workers && npm run react-build:tauri",
    "beforeDevCommand": "npm run build:workers && npm run react-start:tauri",
    "frontendDist": "../build",
    "devUrl": "http://localhost:3001"
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "copyright": "MTG Arena Tool",
    "targets": "all",
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": null
    },
    "longDescription": "MTG Arena Tool - A companion app for Magic: The Gathering Arena",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "resources": [
      "../public/icons/*"
    ],
    "shortDescription": "MTG Arena Tool",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "createUpdaterArtifacts": "v1Compatible"
  },
  "productName": "MTG Arena Tool",
  "mainBinaryName": "MTG Arena Tool",
  "version": "6.7.5",
  "identifier": "com.mtgatool.desktop",
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/mtgatool/mtgatool-desktop/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MTG Arena Tool",
        "width": 1000,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}