{
  "name": "mtgatool-desktop",
  "version": "6.7.5",
  "private": true,
  "homepage": "./",
  "scripts": {
    "dev": "npx tauri dev",
    "dev:web": "npm run build:workers && craco --openssl-legacy-provider start --config craco.web.config.js",
    "build": "npx tauri build",
    "build:web": "npm run build:workers && craco --openssl-legacy-provider build --config craco.web.config.js",
    "build:workers": "npm run build:cards-worker",
    "build:cards-worker": "tsc --p cards-worker-tsconfig.json && browserify ./dist-cards-worker/cards-worker/collectionDataWorker.js --standalone cardsworker > ./dist-cards-worker/index.js && uglifyjs ./dist-cards-worker/index.js -c > ./public/cards-worker/index.js",
    "react-start:tauri": "node generateInfo.js && craco --openssl-legacy-provider start --config craco.tauri.config.js",
    "react-build:tauri": "craco --openssl-legacy-provider build --config craco.tauri.config.js",
    "test": "npm run test:lint && npm run test:unit",
    "test:lint": "eslint src/**",
    "test:unit": "craco test --env=jsdom --watchAll=false",
    "test:watch": "craco test --env=jsdom",
    "proto": "npm-run-all proto:model proto:greTypes proto:eslint",
    "proto:model": "node node_modules/protobufjs/bin/pbjs src/proto/messages.proto > src/proto/model.json",
    "proto:greTypes": "node src/proto/proto2typescript/index.js",
    "proto:eslint": "eslint src/types/greTypes.ts --fix --no-ignore"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^1.5.0",
    "@supabase/supabase-js": "2.39.8",
    "@tauri-apps/api": "^1.6.0",
    "@testing-library/jest-dom": "^5.11.4",
    "@testing-library/react": "^11.1.0",
    "@testing-library/user-event": "^12.1.10",
    "@welldone-software/why-did-you-render": "^6.2.1",
    "axios": "^0.21.1",
    "bytebuffer": "^5.0.1",
    "date-fns": "^2.19.0",
    "extract-zip": "^2.0.1",
    "follow-redirects": "^1.14.3",
    "google-protobuf": "^3.15.6",
    "history": "^4.10.1",
    "lodash": "^4.17.21",
    "match-sorter": "^6.3.0",
    "mathjs": "^9.3.0",
    "mtgatool-shared": "^2.2.0",
    "nan": "^2.20.0",
    "proto2typescript": "^2.2.0",
    "protobufjs": "~5.0.3",
    "qrcode": "^1.5.4",
    "queue": "^6.0.2",
    "random-words": "^1.1.2",
    "react": "^17.0.2",
    "react-autosuggest": "^10.1.0",
    "react-color": "^2.19.3",
    "react-day-picker": "^7.4.10",
    "react-dom": "^17.0.2",
    "react-minimal-pie-chart": "^8.4.1",
    "react-redux": "^7.2.2",
    "react-router-dom": "^5.2.0",
    "react-scripts": "4.0.3",
    "react-spring": "^8.0.27",
    "react-table": "^7.7.0",
    "redux": "^4.0.5",
    "shortid": "^2.2.16",
    "simple-peer": "^9.11.1",
    "tar-fs": "^2.1.1",
    "typescript": "^4.9.5",
    "web-vitals": "^1.0.1",
    "zlib": "^1.0.5"
  },
  "devDependencies": {
    "@craco/craco": "^6.4.5",
    "@tauri-apps/cli": "^1.6.3",
    "@types/bytebuffer": "^5.0.41",
    "@types/follow-redirects": "^1.13.1",
    "@types/jest": "^26.0.15",
    "@types/lodash": "^4.14.168",
    "@types/mathjs": "^6.0.11",
    "@types/node": "^12.0.0",
    "@types/qrcode": "^1.4.2",
    "@types/random-words": "^1.1.0",
    "@types/react": "^17.0.83",
    "@types/react-autosuggest": "^10.1.4",
    "@types/react-color": "^3.0.4",
    "@types/react-dom": "^17.0.0",
    "@types/react-redux": "^7.1.16",
    "@types/react-router-dom": "^5.1.7",
    "@types/react-table": "^7.0.29",
    "@types/secp256k1": "^4.0.1",
    "@types/tar-fs": "^2.0.1",
    "@types/webpack-env": "^1.16.0",
    "browserify": "^17.0.0",
    "eslint": "^7.32.0",
    "eslint-config-airbnb": "^18.2.1",
    "eslint-config-prettier": "^8.1.0",
    "eslint-plugin-cypress": "^2.11.3",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-jest": "^24.3.2",
    "eslint-plugin-jsx": "^0.1.0",
    "eslint-plugin-prettier": "^3.3.1",
    "eslint-plugin-react": "^7.22.0",
    "eslint-plugin-react-hooks": "^4.2.0",
    "eslint-plugin-simple-import-sort": "^8.0.0",
    "file-loader": "^6.2.0",
    "foreman": "^3.0.1",
    "prettier": "^2.2.1",
    "sass": "^1.56.1",
    "text-encoding": "^0.7.0",
    "uglify-js": "^3.15.4",
    "webpack-react-component-name": "^4.0.2"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mtgatool/mtgatool-desktop.git"
  },
  "optionalDependencies": {
    "dmg-license": "^1.0.11"
  },
  "resolutions": {
    "nan": "2.18.0"
  }
}
